{
    "files.exclude": {
        "out": false
    },
    "search.exclude": {
        "out": true
    },
    "task.problemMatchers.neverPrompt": {
        "npm": true
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "[javascript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "oxc.disableNestedConfig": true,
    "oxc.fmt.disableNestedConfig": true
}